APP_NAME="Al Son Del Huila"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_son_del_huila
DB_USERNAME=root
DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Clave de Groq: SOLO en el backend, nunca con prefijo VITE_
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Pon false solo si en local (XAMPP) falla con "cURL error 60"
GROQ_VERIFY_SSL=true

# Duración de los tokens de sesión en minutos (por defecto 7 días)
SANCTUM_EXPIRATION=10080

# Correo (recuperar contraseña).
# Con "log" los correos NO se envían: se escriben en storage/logs/laravel.log (solo para desarrollo).
# Para enviarlos de verdad usa smtp. Ejemplo con Gmail (requiere verificación en 2 pasos y una
# "contraseña de aplicación" creada en https://myaccount.google.com/apppasswords):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=tu_cuenta@gmail.com
#   MAIL_PASSWORD=la_contraseña_de_aplicación
#   MAIL_FROM_ADDRESS=tu_cuenta@gmail.com
# Comprueba la configuración con: php artisan correo:probar tu@correo.com
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@alsondelhuila.local"
MAIL_FROM_NAME="Al Son del Huila"
