APP_NAME="Al Son Del Huila"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_son_del_huila
DB_USERNAME=root
DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Clave de Groq: SOLO en el backend, nunca con prefijo VITE_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Pon false solo si en local (XAMPP) falla con "cURL error 60"
GROQ_VERIFY_SSL=true
